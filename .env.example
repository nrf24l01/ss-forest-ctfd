# Long random secret shared only by CTFd and the serial bridge.
TERRITORY_DEVICE_SECRET=replace-with-a-long-random-secret

# Set this to the host's USB serial device. Remove the serial-bridge service to run without hardware.
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200
TERRITORY_NODE_ID=aa:bb:cc:dd:ee:ff

# Territory Owl instance deployment overlay
TERRITORY_OWL_PUBLIC_HOST=ctfd.example.org
TERRITORY_OWL_FRP_TOKEN=replace-with-a-random-token
TERRITORY_OWL_FRP_IMAGE=fatedier/frp:v0.38.0

# Decimal combat configuration: remaining = old_defense * m - attack_points * n
TERRITORY_DEFENSE_MULTIPLIER=1
TERRITORY_ATTACK_MULTIPLIER=2
